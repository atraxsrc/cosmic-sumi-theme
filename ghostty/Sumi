# Sumi for Ghostty, part of cosmic-sumi-theme (MIT).
# Colours follow the COSMIC Terminal scheme (cosmic-term/).
#
# Install: ./ghostty/install.sh puts this in ~/.config/ghostty/themes/, then in
# ~/.config/ghostty/config:
#   theme = Sumi
# or, with the Sumi Day half installed too, following COSMIC's Dark / Light toggle:
#   theme = dark:Sumi,light:SumiDay

background = #050505
foreground = #D6D0C5

cursor-color = #8B9388
cursor-text = #050505

selection-background = #2A2A2A
selection-foreground = #D6D0C5

split-divider-color = #5F5D58
unfocused-split-fill = #050505

# black
palette = 0=#030303
palette = 8=#5F5D58
